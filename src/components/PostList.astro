---
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const dateFormat = new Intl.DateTimeFormat('en', {
  month: 'short', day: '2-digit', timeZone: 'UTC',
});
---

<section id="posts" class="scroll-mt-6 px-[var(--content-inset)] pt-[clamp(64px,8vw,112px)] pb-[clamp(80px,10vw,144px)] focus:outline-none" aria-label="Posts" tabindex="-1">
  <div class="mx-auto max-w-[1100px]">
    {posts.length > 0 ? (
      <ul class="m-0 flex list-none flex-wrap items-stretch gap-5 p-0" data-post-list>
        {posts.map(({ id, data }) => (
          <li class="flex min-w-0 basis-[calc((100%_-_1.25rem)/2)] single-column:basis-full">
            <a
              class="
                group/post relative flex w-full flex-col gap-4 border-[3px] border-double border-accent-soft/65 bg-surface/92 p-7 font-ascii tracking-normal
                transition-colors duration-180 ease-[ease]
                hover:border-accent hover:bg-surface-hover/96 focus-visible:border-accent focus-visible:bg-surface-hover/96
                mobile:px-5 mobile:py-6 motion-reduce:transition-none
              "
              data-post-link
              href={`/blog/${id}/`}
            >
              <time class="flex gap-2 border-b border-dotted border-accent-soft/40 pr-10 pb-3 text-[12px] leading-6 whitespace-nowrap text-detail" datetime={data.date.toISOString()}>
                <span>{dateFormat.format(data.date)}</span>
                <span class="text-muted">{data.date.getUTCFullYear()}</span>
              </time>
              <div class="flex min-w-0 flex-1 flex-col" data-post-summary>
                <h2 class="m-0 text-[20px] leading-7 font-normal text-foreground [overflow-wrap:anywhere] transition-colors duration-180 ease-[ease] group-hover/post:text-accent group-focus-visible/post:text-accent mobile:text-[18px] motion-reduce:transition-none">{data.title}</h2>
                <p class="m-0 mt-2 text-[14px] leading-6 text-muted [overflow-wrap:anywhere]">{data.description}</p>
                {data.tags.length > 0 && (
                  <ul class="m-0 mt-auto flex list-none flex-wrap gap-x-3 gap-y-1 p-0 pt-4 text-[12px] leading-5 text-detail [overflow-wrap:anywhere]" data-post-tags aria-label="Tags">
                    {data.tags.map((tag) => <li>[{tag}]</li>)}
                  </ul>
                )}
              </div>
              <span class="absolute top-7 right-7 text-right text-[20px] leading-6 whitespace-nowrap text-accent-soft transition-[color,translate] duration-180 ease-[ease] group-hover/post:translate-x-1 group-hover/post:text-accent group-focus-visible/post:text-accent mobile:top-6 mobile:right-5 mobile:text-[18px] motion-reduce:transition-none" aria-hidden="true">{'->'}</span>
            </a>
          </li>
        ))}
      </ul>
    ) : <p class="py-8 text-[14px] text-muted">Nothing here yet. Check back soon.</p>}
  </div>
</section>
