---
import '../styles/global.css';
import ThemeToggle from '../components/ThemeToggle.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'dsal3389 — Code, ideas, and the occasional detour',
  description = 'A personal corner of the internet. Code, ideas, and the occasional detour.',
} = Astro.props;
---

<!doctype html>
<html
  lang="en"
  class="m-0 min-h-full w-full scroll-smooth [font-synthesis:none] [--page-padding:clamp(24px,4.2vw,72px)] [--content-inset:calc(var(--page-padding)+5.1vw)] selection:bg-accent selection:text-surface mobile:[--content-inset:var(--page-padding)] motion-reduce:scroll-auto"
>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#08090b" />
    <meta name="color-scheme" content="dark" />
    <script is:inline>
      // Restore the palette before the page paints, including on article navigation.
      try {
        if (localStorage.getItem('site-theme') === 'eggshell') {
          document.documentElement.dataset.theme = 'eggshell';
          document.querySelector('meta[name="theme-color"]').content = '#f7f3e8';
          document.querySelector('meta[name="color-scheme"]').content = 'light';
        }
      } catch {
        // Storage can be unavailable in private or restricted browsing contexts.
      }
    </script>
    <link rel="preload" href="/fonts/source-code-pro-regular.otf" as="font" type="font/otf" crossorigin />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site)} />
    <title>{title}</title>
  </head>
  <body class="isolate m-0 min-h-full w-full bg-surface font-mono text-foreground antialiased">
    <a class="fixed top-4 left-6 z-10 -translate-y-[180%] bg-accent px-4 py-3 text-surface focus:translate-y-0" href="#main">Skip to content</a>
    <ThemeToggle />
    <slot />
  </body>
</html>
