---
import BaseLayout from '../layouts/BaseLayout.astro';
import AsciiWaves from '../components/AsciiWaves.astro';
import TypewriterText from '../components/TypewriterText.astro';
import PostList from '../components/PostList.astro';
import SiteFooter from '../components/SiteFooter.astro';

const socialLinks = [
  {
    label: 'GitHub',
    href: 'https://git.dsal3389.xyz',
    icon: 'M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23a11.16 11.16 0 0 1 3-.405c1.02 0 2.04.135 3 .405 2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12Z',
  },
  {
    label: 'LinkedIn',
    href: 'https://www.linkedin.com/in/dsal3389/',
    icon: 'M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286ZM5.337 7.433a2.062 2.062 0 1 1 0-4.124 2.062 2.062 0 0 1 0 4.124ZM7.119 20.452H3.555V9H7.119v11.452ZM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003Z',
  },
];
---

<BaseLayout title="Daniel Sonbolian" description="Developer, car enthusiast, and Arch Linux user. Daniel Sonbolian's personal corner of the internet.">
  <AsciiWaves />

  <main id="main" class="focus:outline-none" tabindex="-1">
    <section class="relative isolate h-svh overflow-clip supports-[height:100dvh]:h-dvh" data-hero aria-labelledby="intro-title">
      <div class="absolute inset-x-[var(--page-padding)] top-1/2 -translate-y-1/2 text-[#ed3b3b] outline-none">
        <div class="ml-[5.1vw] mobile:ml-0">
          <nav class="mb-4 flex flex-wrap items-center gap-x-6 gap-y-1 text-[12px] text-[#b8b0b6] short-landscape:mb-2" aria-label="Social links">
            {socialLinks.map(({ label, href, icon }) => (
              <a class="inline-flex min-h-11 items-center gap-2 transition-colors duration-180 ease-[ease] hover:text-red focus-visible:text-red motion-reduce:transition-none" href={href} target="_blank" rel="noopener noreferrer">
                <svg class="size-4 shrink-0 fill-current text-red" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d={icon} /></svg>
                {label}
                <span class="sr-only">(opens in a new tab)</span>
              </a>
            ))}
          </nav>
          <h1 id="intro-title" class="m-0 text-[clamp(42px,6vw,96px)] leading-[1.08] font-normal tracking-[-0.045em] mobile:text-[clamp(38px,11vw,62px)] short-landscape:text-[clamp(38px,6vw,50px)]">Daniel Sonbolian</h1>
          <TypewriterText />
        </div>
      </div>

      <a class="absolute bottom-12 left-1/2 inline-flex size-12 -translate-x-1/2 items-center justify-center text-[28px] leading-none text-red transition-colors duration-180 ease-[ease] hover:text-paper mobile:bottom-7 short-landscape:bottom-4 motion-reduce:transition-none" data-scroll-link href="#posts" aria-label="View posts"><span aria-hidden="true">↓</span></a>
    </section>

    <PostList />
  </main>

  <SiteFooter />
</BaseLayout>
